# ==============================================================================
# Environment Configuration (.env.example)
# คู่มือ & ตัวอย่างตัวแปรสภาพแวดล้อมสำหรับโปรเจกต์ Business & Engineering Bridge
# ==============================================================================
# คำแนะนำการใช้งาน:
# 1. คัดลอกไฟล์นี้เป็น `.env`: cp .env.example .env
# 2. กรอกค่า API Key ตามบริการที่ต้องการเปิดใช้งาน
# 3. ไฟล์ .env จะถูกละเว้นโดย .gitignore อัตโนมัติ เพื่อป้องกันคีย์หลุด
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Providers — ลอง Groq ก่อน แล้วค่อย Gemini (เฉพาะตัวที่ใส่ key ไว้)
#    ถ้าไม่ใส่ key เลย หรือทั้งคู่ตอบไม่ได้ ระบบจะตอบจากคลังความรู้ในตัวแทน
# ------------------------------------------------------------------------------

# [แนะนำ - ฟรี & เร็วสูง] Groq Cloud API Key
# รับ API Key ฟรีได้ที่: https://console.groq.com/keys
# ข้อดี: ประมวลผลเร็วระดับเสี้ยววินาที มี Free Tier รายวัน รองรับ GPT-OSS & Qwen
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"

# [ทางเลือกเสริม] ระบุชื่อโมเดล Groq ที่ต้องการเจาะจงใช้งาน
# หากเว้นว่างไว้ ระบบจะลองโมเดลด้านล่างตามลำดับ (กำหนดไว้ใน server/ask-ai.ts)
# ตัวอย่างโมเดลยอดนิยม:
#   - "openai/gpt-oss-120b"   (ค่าเริ่มต้น: โมเดลขนาดใหญ่ ตอบภาษาไทยได้ดี)
#   - "qwen/qwen3.8-27b"      (ตอบภาษาไทยเข้าใจง่าย แต่ Free Tier ตอบได้แค่ 1,000 token ต่อนาที
#                              ซึ่งน้อยกว่าคำตอบเต็มหนึ่งข้อ จึงมักถูกปฏิเสธถ้าตั้งเป็นตัวแรก)
#   - "openai/gpt-oss-20b"    (โมเดลขนาดกลาง ตอบไว)
GROQ_MODEL=""

# [ตัวสำรอง - ฟรี] Gemini API Key: ใช้เมื่อ Groq ทุกโมเดลตอบไม่ได้ (เช่น ติดโควตาฟรี)
# รับ API Key ฟรีได้ที่: https://aistudio.google.com/apikey
# หมายเหตุ: บน Free Tier Google อาจนำคำถามไปใช้ปรับปรุงผลิตภัณฑ์
GEMINI_API_KEY=""

# [ทางเลือกเสริม] โมเดล Gemini ที่ต้องการให้ลองก่อน
# หากเว้นว่างไว้ ระบบจะลอง "gemini-3.8-flash" แล้วตามด้วย "gemini-3.5-flash-lite"
GEMINI_MODEL=""


# ------------------------------------------------------------------------------
# 2. Server & Runtime Settings (ปกติระบบ Cloud Run/Vite จะตั้งค่าให้อัตโนมัติ)
# ------------------------------------------------------------------------------

# พอร์ตสำหรับ Express + Vite Dev Server (ค่าเริ่มต้น: 3000)
PORT=3000

# โหมดสภาพแวดล้อม: "development" หรือ "production"
NODE_ENV="development"

# URL ของ Web Application (AI Studio จะ Inject ให้อัตโนมัติเมื่อ Deploy)
# ใช้สำหรับสร้าง Canonical URLs, OpenGraph share links และ API endpoints
APP_URL="http://localhost:3000"

# ปิด Hot Module Replacement (HMR) ของ Vite (true/false)
DISABLE_HMR="false"
